{
  "name": "stoic",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "ios:prebuild": "expo prebuild --platform ios --clean",
    "ios:open": "xed ios",
    "ios:build:sim": "xcodebuild -workspace ios/stoic.xcworkspace -scheme stoic -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "ios:build:release": "xcodebuild -workspace ios/stoic.xcworkspace -scheme stoic -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "ios:run": "expo run:ios --no-bundler",
    "ios:run:release": "expo run:ios --no-bundler --configuration Release",
    "doctor": "expo-doctor",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@niondigital/widgets-expo-config-plugin": "^1.1.6",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.17.0",
    "@react-native-firebase/analytics": "^27.1.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/crashlytics": "^27.1.1",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/stack": "^7.12.2",
    "expo": "^58.0.0",
    "expo-alternate-app-icons": "^11.0.0",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-mail-composer": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-tracking-transparency": "~58.1.0",
    "expo-web-browser": "~58.1.0",
    "nativewind": "^2.0.11",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-mmkv": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-toast-message": "^2.5.2",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~58.0.0",
    "tailwindcss": "3.3.2"
  },
  "private": true
}
