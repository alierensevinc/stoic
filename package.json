{
  "name": "stoic",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "ios:prebuild": "expo prebuild --platform ios --clean",
    "ios:open": "xed ios",
    "ios:build:sim": "xcodebuild -workspace ios/stoic.xcworkspace -scheme stoic -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "ios:build:release": "xcodebuild -workspace ios/stoic.xcworkspace -scheme stoic -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "ios:run": "expo run:ios --no-bundler",
    "ios:run:release": "expo run:ios --no-bundler --configuration Release",
    "doctor": "expo-doctor",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@niondigital/widgets-expo-config-plugin": "^1.1.1",
    "@react-native-camera-roll/camera-roll": "^7.8.3",
    "@react-native-clipboard/clipboard": "^1.14.3",
    "@react-native-firebase/analytics": "^21.2.0",
    "@react-native-firebase/app": "^21.2.0",
    "@react-native-firebase/crashlytics": "^21.2.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "expo": "^57.0.0",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dynamic-app-icon": "^1.2.0",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-mail-composer": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-tracking-transparency": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^2.0.11",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^14.2.3",
    "react-native-mmkv": "3.3.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-swipe-list-view": "^3.2.9",
    "react-native-toast-message": "^2.2.1",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^57.0.12",
    "tailwindcss": "3.3.2"
  },
  "private": true
}
