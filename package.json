{
  "name": "stoic",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "build-ios": "npx expo prebuild --platform ios",
    "clean-build-ios": "npx expo prebuild --clean --platform ios",
    "run-ios": "npx expo run:ios",
    "build-and-run-ios": "npx expo prebuild --platform ios && npx expo run:ios",
    "eas-build-ios-simulator": "eas build --profile development-simulator --platform ios",
    "eas-build-ios-development": "eas build --profile development --platform ios",
    "eas-build-ios-preview": "NODE_ENV=development eas build --profile preview --platform ios",
    "eas-build-ios-production": "NODE_ENV=production eas build --profile production --platform ios",
    "eas-submit-ios": "eas submit -p ios --latest",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
