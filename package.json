{
  "name": "stoic",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:client": "expo start --dev-client",
    "start:clean": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "ios:prebuild": "expo prebuild --platform ios",
    "ios:prebuild:clean": "expo prebuild --platform ios --clean",
    "ios:fresh": "expo prebuild --platform ios --clean && expo run:ios",
    "ios:build:dev": "eas build --profile development --platform ios",
    "ios:build:sim": "eas build --profile development-simulator --platform ios",
    "ios:build:preview": "NODE_ENV=development eas build --profile preview --platform ios",
    "ios:build:prod": "NODE_ENV=production eas build --profile production --platform ios",
    "ios:submit": "eas submit -p ios --latest",
    "ios:device": "expo run:ios --device",
    "ios:device:release": "expo run:ios --device --configuration Release",
    "android:prebuild": "expo prebuild --platform android",
    "android:prebuild:clean": "expo prebuild --platform android --clean",
    "android:fresh": "expo prebuild --platform android --clean && expor run:android",
    "android:build:dev": "eas build --profile development --platform android",
    "android:build:preview": "NODE_ENV=development eas build --profile preview --platform android",
    "android:build:prod": "NODE_ENV=production eas build --profile production --platform android",
    "android:submit": "eas submit -p android --latest",
    "cleanup": "node scripts/cleanup.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-camera-roll/camera-roll": "^7.8.3",
    "@react-native-clipboard/clipboard": "^1.14.3",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/analytics": "^21.2.0",
    "@react-native-firebase/app": "^21.2.0",
    "@react-native-firebase/crashlytics": "^21.2.0",
    "@react-native-firebase/perf": "^21.2.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.26",
    "@react-navigation/stack": "^6.4.1",
    "@niondigital/widgets-expo-config-plugin": "^1.1.1",
    "add": "^2.0.6",
    "axios": "^1.7.5",
    "expo": "~53.0.23",
    "expo-application": "~6.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-device": "7.1.4",
    "expo-dynamic-app-icon": "^1.2.0",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-insights": "~0.9.3",
    "expo-mail-composer": "~14.1.6",
    "expo-notifications": "~0.31.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-store-review": "~8.1.5",
    "expo-tracking-transparency": "~5.2.4",
    "expo-web-browser": "~14.2.0",
    "moment": "^2.30.1",
    "nativewind": "^2.0.11",
    "prop-types": "^15.8.1",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-google-mobile-ads": "^14.2.3",
    "react-native-mmkv": "3.3.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-share": "^11.0.4",
    "react-native-swipe-list-view": "^3.2.9",
    "react-native-toast-message": "^2.2.1",
    "react-native-view-shot": "4.0.3",
    "react-navigation": "^5.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "tailwindcss": "3.3.2"
  },
  "private": true
}
